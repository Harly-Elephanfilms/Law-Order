{
  "name": "lawandorder-shop",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "data": "python3 scripts/build_data.py",
    "episodes": "python3 scripts/build_episodes.py",
    "episodes:first": "python3 scripts/build_early_episodes.py",
    "test:episodes-first": "python3 -m unittest discover -s scripts -p 'test_early_episodes.py'",
    "test:episodes": "python3 -m unittest discover -s scripts -p 'test_*episodes.py'",
    "booklet": "python3 scripts/build_booklet.py",
    "essay": "python3 scripts/build_essay.py",
    "images": "python3 scripts/build_data.py --images-only && node scripts/build_images.mjs",
    "images:png": "node scripts/convert_source_images.mjs",
    "images:update": "python3 scripts/build_data.py --images-only --seasons=5,6,7,8,9,10 && node scripts/build_images.mjs --seasons=5,6,7,8,9,10",
    "images:update-first": "python3 scripts/build_data.py --images-only --seasons=1,2,3,4 && node scripts/build_images.mjs --seasons=1,2,3,4 --integrales=11-15",
    "test:images": "node --test scripts/episode_images.test.mjs",
    "video": "bash scripts/build_video.sh",
    "dev": "astro dev",
    "build": "astro build",
    "build:release": "astro build && node scripts/check_site.mjs",
    "check:release": "node scripts/check_site.mjs",
    "check:preview": "node scripts/check_site.mjs --preview",
    "build:preview": "PUBLIC_PREVIEW=1 astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/three": "^0.185.4",
    "typescript": "^6.0.3"
  }
}
